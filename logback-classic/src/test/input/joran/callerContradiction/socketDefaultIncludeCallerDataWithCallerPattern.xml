<!-- SocketAppender with includeCallerData=false (default) alongside a
     ConsoleAppender whose pattern uses %C (caller class).
     DO_NOT_WANT (SOCKET) + DIRECT_WANT (CONSOLE) should trigger a WARN. -->
<configuration debug="false">

    <import class="ch.qos.logback.core.ConsoleAppender"/>
    <import class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"/>
    <import class="ch.qos.logback.classic.net.SocketAppender"/>

    <appender name="CONSOLE" class="ConsoleAppender">
        <encoder class="PatternLayoutEncoder">
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %C.%M:%L - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="SOCKET" class="SocketAppender">
        <remoteHost>127.0.0.1</remoteHost>
        <port>4560</port>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SOCKET"/>
    </root>

</configuration>
