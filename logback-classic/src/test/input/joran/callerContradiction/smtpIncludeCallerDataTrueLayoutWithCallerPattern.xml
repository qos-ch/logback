<!-- SMTPAppender with includeCallerData=true and a layout whose pattern uses
     %C. PREPROCESS_WANT (EMAIL.includeCallerData) + DIRECT_WANT (EMAIL.layout)
     is allowed; no contradiction WARN. -->
<configuration debug="false">

    <import class="ch.qos.logback.classic.net.SMTPAppender"/>
    <import class="ch.qos.logback.classic.PatternLayout"/>

    <appender name="EMAIL" class="SMTPAppender">
        <includeCallerData>true</includeCallerData>
        <smtpHost>localhost</smtpHost>
        <to>test@localhost</to>
        <from>test@localhost</from>
        <layout class="PatternLayout">
            <pattern>%d %-5level %C.%M:%L - %msg%n</pattern>
        </layout>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="EMAIL"/>
    </root>

</configuration>
