<!-- Two AsyncAppenders with includeCallerData=false (default) and two nested
     appenders that need caller data. Names of both DO_NOT_WANT and DIRECT_WANT
     groups should appear joined in the warning. -->
<configuration debug="false">

    <import class="ch.qos.logback.core.ConsoleAppender"/>
    <import class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"/>
    <import class="ch.qos.logback.classic.AsyncAppender"/>

    <appender name="CONSOLE" class="ConsoleAppender">
        <encoder class="PatternLayoutEncoder">
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %C - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ConsoleAppender">
        <encoder class="PatternLayoutEncoder">
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %F - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC1" class="AsyncAppender">
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="CONSOLE"/>
    </appender>

    <appender name="ASYNC2" class="AsyncAppender">
        <appender-ref ref="FILE"/>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="ASYNC1"/>
        <appender-ref ref="ASYNC2"/>
    </root>

</configuration>
